# Copy file này thành ".env" (bỏ đuôi .example) rồi chỉnh nếu cần.
# Không bắt buộc phải tạo — nếu không có .env, các giá trị mặc định
# trong app/config.py đã được tối ưu sẵn cho GPU 6GB VRAM.

# Đường dẫn tới file model GGUF (đặt file .gguf vào thư mục models/)
MODEL_PATH=models/Qwen3-4B-Q5_K_M.gguf

# Whisper (Speech-to-Text) — chạy CPU để dành VRAM cho LLM
WHISPER_MODEL=small
WHISPER_LANGUAGE=vi
STT_DEVICE=cpu

# LLM — số layer offload lên GPU. -1 = toàn bộ (khuyến nghị cho 6GB VRAM
# với model 4B Q5_K_M). Nếu bị lỗi "out of memory" khi khởi động, giảm
# dần: 28, 20, 10... (model Qwen3-4B có khoảng 36 layer)
N_GPU_LAYERS=-1
LLM_CONTEXT=4096
LLM_BATCH=512
LLM_MAX_TOKENS=400

# Server
HOST=0.0.0.0
PORT=8000
