# ============================================================
# BeeNavi AI — .env.example
# ============================================================
# Sao chép file này thành .env và điền giá trị thực tế:
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux/macOS)
# ============================================================

# ── AI Engine (FastAPI :8000) ────────────────────────────────
HOST=0.0.0.0
PORT=8000

# LLM (Qwen3-4B)
N_GPU_LAYERS=-1
LLM_CONTEXT=4096
LLM_BATCH=128
LLM_MAX_TOKENS=2048
# FLASH_ATTN=0  ← TẮT cho GTX 1660 Ti. Bật (=1) cho RTX 30xx+

# STT (Faster-Whisper)
WHISPER_MODEL=small
WHISPER_LANGUAGE=vi
STT_DEVICE=cpu

# TTS (VieNeu-TTS)
TTS_ENABLED=1
TTS_ENGINE=vieneu
TTS_VOICE=vi_default
TTS_DEVICE=auto

# ── Auth & Security ──────────────────────────────────────────
AUTH_SECRET_SALT=beenavi_super_secret_auth_salt_prod_2026

# ── External APIs ────────────────────────────────────────────
# Lấy API key miễn phí tại: https://openweathermap.org/api
WEATHER_API_KEY=your-openweathermap-api-key-here
